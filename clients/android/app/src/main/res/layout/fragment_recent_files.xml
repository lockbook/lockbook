<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <HorizontalScrollView
            android:id="@+id/recent_editor_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/recent_editor_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/recent_editor_filter"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/recent_editor_filter_heading"
                    app:chipIcon="@drawable/ic_baseline_tune_24"
                    app:chipIconVisible="true"
                    app:iconStartPadding="8dp"
                    app:iconEndPadding="8dp"
                    app:textStartPadding="0dp"
                    app:textEndPadding="0dp"
                    app:ensureMinTouchTargetSize="true" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recent_files_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/recent_files_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:drawablePadding="16dp"
        android:gravity="center"
        android:text="@string/no_recent_documents"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone"
        app:drawableTint="?attr/colorOnSurfaceVariant"
        app:drawableTopCompat="@drawable/ic_outline_insert_drive_file_24"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
